# Batch run (no graphics):  ./sim run.mac
/vis/disable
/tracking/storeTrajectory 0

/run/initialize

# 14 MeV neutrons (DT), pencil beam, 10 cm in front of the rock (rock face at z = 0)
/gps/particle neutron
/gps/energy 14 MeV
/gps/pos/type Point
/gps/pos/centre 0 0 -10 cm
/gps/direction 0 0 1

/run/printProgress 10

# Test first with 10, then change to 1000000 for the real run
/run/beamOn 1000000
